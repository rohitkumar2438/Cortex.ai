# ==============================================================================
# Cortex AI - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose or individual services:
# cp .env.example .env

NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Databases & Caching
# ------------------------------------------------------------------------------
# Local Docker or MongoDB Atlas URI:
MONGO_URI=mongodb://localhost:27017/cortex
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. Authentication (Firebase Admin & Client)
# ------------------------------------------------------------------------------
# Paste the JSON content or path of your Firebase Admin Service Account:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project"}

# Frontend Firebase Web SDK config:
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 3. AI / LLM Providers
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Chat Router, Chat Agent, PDF & PPT Authoring):
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily Search API Key (Live Web Search & Fact Retrieval):
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# DeepSeek API Key (Full-Stack Coding Agent & Code Generation):
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Google Gemini API Key (Optional Multimodal fallback):
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# OpenAI API Key (Optional for text-embedding-3-small embeddings):
OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Vector Database (RAG Knowledge Engine)
# ------------------------------------------------------------------------------
# Pinecone Serverless (Optional; automatically falls back to built-in in-memory vector store):
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=cortex-ai

# ------------------------------------------------------------------------------
# 5. Billing & Payments (Razorpay)
# ------------------------------------------------------------------------------
# Test keys from https://dashboard.razorpay.com/ (Optional dev mock mode supported if blank):
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. Storage & Cloud (Optional S3 upload for PDF/PPT/Image files)
# ------------------------------------------------------------------------------
# If omitted, generated artifacts are saved to local volume and served via /agent/downloads/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ------------------------------------------------------------------------------
# 7. Gateway & Service Endpoints
# ------------------------------------------------------------------------------
PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
