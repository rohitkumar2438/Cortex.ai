{
  "name": "collegeproject",
  "version": "1.0.0",
  "description": "Root workspace to start all services",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -n \"front,gate,auth,chat,bill,agent\" -c \"bgBlue,bgGreen,bgMagenta,bgCyan,bgYellow,bgWhite\" \"npm run dev --prefix frontend\" \"npm run dev --prefix backend/gateway\" \"npm run dev --prefix backend/services/auth\" \"npm run dev --prefix backend/services/chat\" \"npm run dev --prefix backend/services/billing\" \"npm run dev --prefix backend/services/agent\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^0.2.5",
    "@langchain/pinecone": "^1.0.3",
    "@pinecone-database/pinecone": "^8.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-http-proxy": "^2.1.2",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.3.0",
    "form-data": "^4.0.5",
    "helmet": "^8.3.0",
    "langchain": "^1.5.10",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.1.1",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "razorpay": "^2.9.6",
    "redis": "^6.3.0"
  }
}
